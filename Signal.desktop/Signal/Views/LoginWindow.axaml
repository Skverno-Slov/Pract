<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Signal.Views.LoginWindow"
        Title="Signal: Панель администратора / Авторизация"
		xmlns:vm="using:Signal.ViewModels"
		x:DataType="vm:LoginWindowViewModel"
		Icon="/Assets/avalonia-logo.ico">
	<Grid Margin="35" RowDefinitions="*, Auto, *">
		<StackPanel Grid.Row="1" Spacing="18">

			<StackPanel HorizontalAlignment="Center" Margin="0,0,0,15">
				<TextBlock Text="SIGNALTRACK" FontSize="26" LetterSpacing="2"/>
			</StackPanel>

			<StackPanel Spacing="5">
				<TextBlock Text="Логин" FontSize="12" FontWeight="SemiBold"/>
				<TextBox Text="{Binding Login}" Watermark="Введите логин"/>
			</StackPanel>

			<StackPanel Spacing="5">
				<TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold"/>
				<TextBox Text="{Binding Password}" PasswordChar="•" Watermark="Введите пароль"/>
			</StackPanel>

			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12"
                       HorizontalAlignment="Center" TextWrapping="Wrap" Height="35"
                       IsVisible="{Binding !!ErrorMessage}"/>

			<StackPanel Spacing="10">
				<Button Content="Войти" Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="11" FontWeight="Bold"/>

				<Button Content="Настройки подключения" Command="{Binding OpenSettingsCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="Transparent" Padding="8"/>
			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
