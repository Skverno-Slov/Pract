<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Signal.UserRedactorPage"
			 xmlns:vm="using:Signal.ViewModels"
             x:DataType="vm:UserRedactorPageViewModel"
			 Loaded="UsersRedactorPage_Loaded">
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
		<StackPanel Margin="20">
			<StackPanel Margin="5">
				<TextBlock Text="Логин:"/>
				<TextBox Text="{Binding Login}"/>
			</StackPanel>

			<StackPanel Margin="5">
				<TextBlock Text="Фамилия:"/>
				<TextBox Text="{Binding SecondName}"/>
			</StackPanel>

			<StackPanel Margin="5">
				<TextBlock Text="Имя:"/>
				<TextBox Text="{Binding FirstName}"/>
			</StackPanel>

			<StackPanel Margin="5">
				<TextBlock Text="Отчество:"/>
				<TextBox Text="{Binding LastName}"/>
			</StackPanel>

			<StackPanel Margin="5">
				<TextBlock Text="Пароль: "/>
				<TextBox Text="{Binding Password}" PasswordChar="*"/>
			</StackPanel>

			<StackPanel Margin="5"
						IsVisible="{Binding IsEditMode}">
				<TextBlock Text="Роли:" FontWeight="Bold"/>
				<ItemsControl ItemsSource="{Binding Roles}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<CheckBox Content="{Binding RoleName}"
							          IsChecked="{Binding IsSelected}"
							          Margin="0,2"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
				<Button Content="Назад"
						Command="{Binding CloseCommand}"
						Margin="0,0,5,0"/>
				<Button Content="Сохранить"
				        Command="{Binding SaveCommand}"
				        IsVisible="{Binding IsEditMode}"/>
				<Button Content="Добавить"
				        Command="{Binding SaveCommand}"
				        IsVisible="{Binding !IsEditMode}"/>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
